# DriveCodex crawl agent — local secrets (TEMPLATE)
#
# Copy this file to ".env.local" in the same folder and fill in the values.
# ".env.local" is git-ignored and must NEVER be committed.
#
# Once filled, the agent operates Supabase autonomously:
#   - run-agent-batch.ps1 loads it automatically (scheduled runs)
#   - manual runs:  node --experimental-sqlite --env-file=scripts/agent/.env.local scripts/agent/orchestrator.mjs ...
#   - migrations:   the agent can run `supabase db push` non-interactively
#
# Format: KEY=value  (no "export", no quotes needed; '#' starts a comment)

# Supabase project (public — already correct for production)
SUPABASE_URL=https://nmvjthfezyjcwuzphiuu.supabase.co

# service_role API key — Dashboard → Project Settings → API → "service_role" (secret).
# Enables the online crawl_forums registry + case import + crosscheck.
SUPABASE_SERVICE_KEY=

# Database password — Dashboard → Project Settings → Database → "Database password"
# (reset it there if unknown). Lets `supabase db push` apply migrations without prompting.
SUPABASE_DB_PASSWORD=

# DeepSeek API key — used for the independent verification step (cross-vendor auditor).
DEEPSEEK_API_KEY=

# ── Anti-bot fetch tuning (all OPTIONAL) ─────────────────────────────────────
# The crawler fetches in escalating tiers: plain fetch → fingerprinted HTTP
# (got-scraping) → system-Chrome DOM dump → Crawlee/Playwright. The two
# got-scraping/Crawlee tiers ship with the project (no extra install).

# Residential/datacenter proxy for the Crawlee tier, as a full proxy URL.
# Only needed for IP-reputation blocks. NOTE (verified 2026-07-13): a proxy does
# NOT fix dieselpower.cz / forum.mazdaklub.eu — those 403 regardless of IP.
# AGENT_PROXY_URL=http://USER:PASS@proxy.host:PORT

# Fingerprinted HTTP retry (got-scraping) escalation. OPT-IN (default off) so it
# never changes the nightly run without a deliberate switch. Set to 1 to enable —
# clears TLS/header-fingerprint WAFs (e.g. audizine.com 403→200) without a browser.
# AGENT_ENABLE_GOTSCRAPING=1

# Set to 1 to disable the Crawlee/Playwright browser escalation.
# AGENT_DISABLE_CRAWLEE=1

# robots.txt handling. Unset/off = ignore robots (current behavior). 'log' =
# fetch robots.txt and log which URLs it WOULD disallow, but still crawl (use
# this to measure impact). 'enforce' = actually skip disallowed URLs — can cut
# coverage sharply since many forums disallow bots, so measure with 'log' first.
# AGENT_ROBOTS_MODE=log
